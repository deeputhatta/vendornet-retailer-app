{
  "expo": {
    "name": "VendorNet",
    "slug": "vendornet-retailer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#185FA5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.vendornet.retailer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#185FA5"
      },
      "edgeToEdgeEnabled": true,
      "package": "in.vendornet.retailer",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#185FA5"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "2b4d42c5-08fb-45ba-b1e2-6c14ec2c510b"
      }
    },
    "owner": "deepusthatta"
  }
}
